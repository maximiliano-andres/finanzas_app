# ==============================================================================
# CONFIGURACIÓN DE LA BASE DE DATOS (POSTGRESQL)
# ==============================================================================
# DB_USER: Usuario de acceso a la base de datos
DB_USER=app_user
# DB_PASS: Contraseña de acceso a la base de datos
DB_PASS=app_password_123
# DB_HOST: Host del servidor de base de datos (para desarrollo local suele ser 127.0.0.1 o localhost, en Docker se usa 'db')
DB_HOST=127.0.0.1
# DB_PORT: Puerto del servidor de base de datos (5432 por defecto en PostgreSQL)
DB_PORT=5432
# DB_NAME: Nombre de la base de datos a utilizar
DB_NAME=empresa_db
# DATABASE_URL: URL de conexión asíncrona de SQLAlchemy.
# NOTA: En producción, vincula el password e IP correspondientes al driver 'postgresql+asyncpg'.
DATABASE_URL=postgresql+asyncpg://app_user:app_password_123@db:5432/empresa_db
# POSTGRES_PASSWORD: Clave maestra de PostgreSQL utilizada por el contenedor de base de datos en Docker.
POSTGRES_PASSWORD=postgres_password_123

# ==============================================================================
# CONFIGURACIÓN DE REDIS (RATE LIMITING Y MFA)
# ==============================================================================
# REDIS_URL: Dirección del servidor Redis. Se utiliza para rate limiting, bloqueo de logins y flujos OTP.
REDIS_URL=redis://:redis_password_123@redis:6379/0
# REDIS_PASSWORD: Contraseña para la autenticación de Redis.
REDIS_PASSWORD=redis_password_123

# ==============================================================================
# CONFIGURACIÓN DE SEGURIDAD JWT (TOKENS DE SESIÓN)
# ==============================================================================
# SECRET_KEY: Clave secreta para firmar los tokens JWT. Debe ser altamente segura en producción.
SECRET_KEY=example-super-secure-secret-key-change-in-production
# JWT_ALGORITHM: Algoritmo de hashing usado para la firma de tokens JWT. (Por defecto: HS256)
JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_SECONDS: Tiempo de vida en segundos del token de acceso (86400 = 1 día)
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=86400
# JWT_REFRESH_TOKEN_EXPIRE_SECONDS: Tiempo de vida en segundos del token de refresco (604800 = 7 días)
JWT_REFRESH_TOKEN_EXPIRE_SECONDS=604800

# ==============================================================================
# AUTENTICACIÓN DE DOBLE FACTOR (2FA / MFA)
# ==============================================================================
# FERNET_KEY: Clave de cifrado simétrico Fernet para encriptar los secretos TOTP en la Base de Datos.
# Generar una nueva con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=AbCdEfGhIjKlMnOpQrStUvWxYz1234567890abcdEF=
# MFA_ISSUER_NAME: Nombre del emisor que se mostrará en aplicaciones de autenticación como Google Authenticator.
MFA_ISSUER_NAME=MiAplicacion
# MFA_DOMAIN: Dominio asociado a la cuenta de autenticación MFA.
MFA_DOMAIN=empresa.cl
# MFA_BACKUP_CODES_COUNT: Cantidad de códigos de recuperación autogenerados al activar MFA (Por defecto: 10)
MFA_BACKUP_CODES_COUNT=10

# ==============================================================================
# CONFIGURACIÓN DE SERVICIO DE EMAIL (SMTP)
# ==============================================================================
# SMTP_HOST: Servidor SMTP para enviar correos electrónicos (ej. smtp.gmail.com, smtp.mailtrap.io)
SMTP_HOST=smtp.gmail.com
# SMTP_PORT: Puerto del servidor SMTP (587 para TLS/STARTTLS, 465 para SSL, 2525 para Mailtrap)
SMTP_PORT=587
# SMTP_USER: Usuario / correo del remitente SMTP
SMTP_USER=no-reply@empresa.cl
# SMTP_PASSWORD: Contraseña de la cuenta SMTP o token de aplicación de correo
SMTP_PASSWORD=app_email_password_123
# SMTP_FROM: Dirección de correo electrónico de origen mostrada al destinatario
SMTP_FROM=no-reply@empresa.cl
# ALLOWED_EMAIL_DOMAINS: Dominios de correo permitidos para registro de usuarios (separados por comas)
ALLOWED_EMAIL_DOMAINS=empresa.cl,empresa.com,gmail.com,outlook.com

# ==============================================================================
# RATE LIMITING Y PARÁMETROS DE BLOQUEO DE SEGURIDAD
# ==============================================================================
# LOGIN_MAX_ATTEMPTS: Intentos de contraseña fallidos antes del bloqueo temporal (Por defecto: 5)
LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_DURATION_SECONDS: Duración en segundos del bloqueo tras superar intentos de login (900 = 15 min)
LOGIN_LOCK_DURATION_SECONDS=900
# MFA_MAX_ATTEMPTS: Intentos fallidos permitidos para ingresar código 2FA antes del bloqueo (Por defecto: 5)
MFA_MAX_ATTEMPTS=5
# MFA_LOCK_DURATION_SECONDS: Duración en segundos del bloqueo tras superar intentos de MFA (900 = 15 min)
MFA_LOCK_DURATION_SECONDS=900
# MFA_PENDING_EXPIRE_SECONDS: Tiempo límite de sesión pendiente por verificar MFA (300 = 5 min)
MFA_PENDING_EXPIRE_SECONDS=300
# EMAIL_OTP_EXPIRE_SECONDS: Duración del código OTP enviado por correo en segundos (300 = 5 min)
EMAIL_OTP_EXPIRE_SECONDS=300
# EMAIL_OTP_RATE_LIMIT_SECONDS: Tiempo mínimo de espera para reenviar otro código OTP (60 = 1 min)
EMAIL_OTP_RATE_LIMIT_SECONDS=60

# ==============================================================================
# CONFIGURACIÓN DE CORS
# ==============================================================================
# CORS_ALLOWED_ORIGINS: Dominios permitidos para llamadas de origen cruzado en API (separados por comas)
CORS_ALLOWED_ORIGINS=http://example.local:8000,http://localhost:8000,http://127.0.0.1:8000

# ==============================================================================
# CONFIGURACIÓN DEL SEED / DATOS INICIALES DE LA BASE DE DATOS
# ==============================================================================
# SEED_SUPER_ADMIN_EMAIL: Correo electrónico del usuario Super Administrador inicial (CAMBIAR CORREO DE EJEMPLO A ELECCION)
SEED_SUPER_ADMIN_EMAIL=super_admin@flujopago.cl
# SEED_SUPER_ADMIN_PASSWORD: Contraseña para la cuenta del usuario Super Administrador inicial sigue reglas de minimo:
# - 1 simbolo 
# - 1 mayuscula
# - 1 minuscula
# - 1 numero o digito
# - largo de minimo de 8 caracteres (CAMBIAR CONTRASEÑA DE EJEMPLO A ELECCION)
SEED_SUPER_ADMIN_PASSWORD=@Admin_Flujo2026
# Si se omite SEED_SUPER_ADMIN_PASSWORD, en la primera instalación se genera una contraseña aleatoria
# y se informa una sola vez en el log de arranque (ya no existe una contraseña por defecto en el código).

# EMAILS_PRUEBA_PERMITIDOS: emails fuera de los dominios corporativos (@flujopago.cl, @grupodemo.cl) que se
# aceptan en login/creación de usuarios (separados por coma). Sin la variable se usa la lista histórica del
# código. En producción se recomienda dejarla vacía (EMAILS_PRUEBA_PERMITIDOS=) o con las cuentas estrictamente
# necesarias. SEED_SUPER_ADMIN_EMAIL siempre queda permitido. Los @pushhr.cl siguen permitidos.
# EMAILS_PRUEBA_PERMITIDOS=

# ==============================================================================
# LISTADOS
# ==============================================================================
# LISTADO_MAX_REGISTROS: tope de seguridad para listados SIN limit/offset (el frontend no pagina).
# Si se alcanza, se registra una advertencia en el log. Por defecto 10000.
LISTADO_MAX_REGISTROS=10000

# IMPORTANTE LA FUNCION os.getenv() RECIBE LAS VARIABLES DE ENTORNO Y TIENEN VALORES DEFAULT ADEMAS DE EL VALOR DE LA VARIABLE DEL .ENV POR PRECAUCION LOS CUALES DEBEN CAMBIAR A SU PREFERENCIA DADO EL CASO.